generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id         String    @id @default(cuid())
  name       String
  type       String
  cutoffDay  Int?
  paymentDay Int?
  createdAt  DateTime  @default(now())
  expenses   Expense[]
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, name])
  @@unique([id, bookId])
}

model Budget {
  id          String   @id @default(cuid())
  type        String
  amountCents Int
  updatedAt   DateTime @updatedAt
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, type])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  expenses       Expense[]
  categoryBudget CategoryBudget?
  bookId         String
  book           Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, name])
  @@unique([id, bookId])
}

model CategoryBudget {
  id          String   @id @default(cuid())
  categoryId  String   @unique
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amountCents Int
  updatedAt   DateTime @updatedAt
}

enum Role {
  user
  admin
}

enum BookRole {
  editor
  viewer
}

model Book {
  id          String           @id @default(cuid())
  name        String
  ownerId     String
  owner       User             @relation("OwnedBooks", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  members     BookMember[]
  invitations BookInvitation[]
  accounts    Account[]
  categories  Category[]
  expenses    Expense[]
  budgets     Budget[]
  activeFor   User[]           @relation("ActiveBook")

  @@index([ownerId])
}

model BookMember {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BookRole
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([userId])
}

model BookInvitation {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  role      BookRole
  email     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([bookId])
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String?
  lastName            String?
  passwordHash        String?
  passwordSalt        String?
  passwordReplaced    Boolean      @default(false)
  emailVerifiedAt     DateTime?
  googleId            String?      @unique
  profileIncomplete   Boolean      @default(false)
  role                Role         @default(user)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  sessions            Session[]
  tokens              UserToken[]
  activeBookId        String?
  activeBook          Book?        @relation("ActiveBook", fields: [activeBookId], references: [id], onDelete: SetNull)
  ownedBooks          Book[]       @relation("OwnedBooks")
  memberships         BookMember[]
}

model UserToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  purpose   String
  newEmail  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

model EmailSend {
  id        String   @id @default(cuid())
  recipient String
  createdAt DateTime @default(now())

  @@index([recipient, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id                String   @id @default(cuid())
  amountCents       Int
  date              DateTime
  description       String
  notes             String?
  type              String?
  excludeFromTotals Boolean  @default(false)
  msiGroupId        String?
  createdAt         DateTime @default(now())

  accountId  String
  account    Account   @relation(fields: [accountId, bookId], references: [id, bookId], onDelete: NoAction)
  categoryId String?
  category   Category? @relation(fields: [categoryId, bookId], references: [id, bookId], onDelete: NoAction)
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([id, bookId])
}
