generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id         String    @id @default(cuid())
  name       String    @unique
  type       String
  cutoffDay  Int?
  paymentDay Int?
  createdAt  DateTime  @default(now())
  expenses   Expense[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id                String   @id @default(cuid())
  amountCents       Int
  date              DateTime
  description       String
  type              String?
  excludeFromTotals Boolean  @default(false)
  msiGroupId        String?
  createdAt         DateTime @default(now())

  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}
